#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

// Layers 

#define DVORAK_L 0
#define KP_L 1
#define FN_L 2
#define MOD_L 3
#define GAME_L 4

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        /* hm: homerow_mods { */
        /*     compatible = "zmk,behavior-hold-tap"; */
        /*     #binding-cells = <2>; */
        /*     tapping-term-ms = <200>; */
        /*     flavor = "tap-preferred"; */
        /*     bindings = <&kp>, <&kp>; */
        /* }; */
        pkp_n1: plus_kp_n1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp N1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lkp_n2: left_bracket_kp_n2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp N2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lkp_n3: left_brace_kp_n3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp N3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lkp_n4: left_parenthesis_kp_n4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp N4>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        akp_n5: amps_kp_n5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AMPS>, <&kp N5>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ekp_n6: equal_kp_n6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp N6>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rkp_n7: right_parenthesis_kp_n7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp N7>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rkp_n8: right_brace_kp_n8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACE>, <&kp N8>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rkp_n9: right_bracket_kp_n9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp N9>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        skp_n0: star_kp_n0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp STAR>, <&kp N0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Symbols

        dtilde: dllr_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DLLR>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ahash: at_hash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AT>, <&kp HASH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        pmult: percent_multiply {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PERCENT>, <&kp STAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
            
            

        ecar: excl_caret {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EXCL>, <&kp CARET>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        dvorak {
            display-name = "Base";
            bindings = <
//    ┌─────────┬─────────┬─────────┬─────────┬─────────┬─────────┬────────────┐                           ┌──────────┬─────────┬─────────┬─────────┬─────────┬─────────┬─────────┐
//    │ &dtilde │ &pkp_n1 │ &lkp_n2 │ &lkp_n3 │ &lkp_n4 │ &akp_n5 │  tog KP_L  │                           │ mo MOD_L │ &ekp_n6 │ &rkp_n7 │ &rkp_n8 │ &rkp_n9 │ &skp_n0 │    |    │
//    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┼────────────┤                           ├──────────┼─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
//    │   tab   │    ;    │    ,    │    .    │    P    │    Y    │ tog GAME_L │                           │          │    F    │    G    │    C    │    R    │    L    │    /    │
//    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┼────────────┼──────┬──────┬──────┬──────┼──────────┼─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
//    │   esc   │    A    │    O    │    E    │    U    │    I    │   &ecar    │ lctl │ lalt │ lgui │ rctl │  &pmult  │    D    │    H    │    T    │    N    │    S    │    -    │
//    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┼────────────┴──────┼──────┼──────┼──────┴──────────┼─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
//    │  lsft   │    '    │    Q    │    J    │    K    │    X    │                   │ home │ pgup │                 │    B    │    M    │    W    │    V    │    Z    │  rsft   │
//    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┼────────────┬──────┼──────┼──────┼──────┬──────────┼─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
//    │ mo FN_L │    `    │  caps   │  left   │  rght   │         │    bspc    │ del  │ end  │ pgdn │ ent  │   spc    │         │   up    │  down   │    \    │ &ahash  │ mo FN_L │
//    └─────────┴─────────┴─────────┴─────────┴─────────┘         └────────────┴──────┴──────┴──────┴──────┴──────────┘         └─────────┴─────────┴─────────┴─────────┴─────────┘
  &dtilde     &pkp_n1     &lkp_n2     &lkp_n3    &lkp_n4     &akp_n5   &tog KP_L                                                           &mo MOD_L   &ekp_n6   &rkp_n7   &rkp_n8    &rkp_n9         &skp_n0   &kp PIPE
  &kp TAB     &kp SEMI    &kp COMMA   &kp DOT    &kp P       &kp Y     &tog GAME_L                                                         &trans      &kp F     &kp G     &kp C      &kp R           &kp L     &kp FSLH
  &kp ESC     &kp A       &kp O       &kp E      &kp U       &kp I     &ecar         &kp LCTRL   &kp LEFT_ALT   &kp LEFT_WIN   &kp RCTRL   &pmult      &kp D     &kp H     &kp T      &kp N           &kp S     &kp MINUS
  &kp LSHFT   &kp SQT     &kp Q       &kp J      &kp K       &kp X                               &kp HOME       &kp PG_UP                              &kp B     &kp M     &kp W      &kp V           &kp Z     &kp RSHFT
  &mo FN_L    &kp GRAVE   &kp CAPS    &kp LEFT   &kp RIGHT             &kp BSPC      &kp DEL     &kp END        &kp PG_DN      &kp RET     &kp SPACE             &kp UP    &kp DOWN   &kp BACKSLASH   &ahash    &mo FN_L
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────┐                       ┌──────┬─────┬─────┬─────┬───┬─────┬─────┐
//    │     │  1  │  2  │  3  │  4  │  5  │ tog KP_L │                       │ mo 4 │  6  │  7  │  8  │ 9 │  0  │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼──────────┤                       ├──────┼─────┼─────┼─────┼───┼─────┼─────┤
//    │     │     │     │     │     │     │          │                       │      │     │  7  │  8  │ 9 │  -  │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼──────────┼─────┬─────┬─────┬─────┼──────┼─────┼─────┼─────┼───┼─────┼─────┤
//    │     │     │     │     │     │     │          │     │     │     │     │      │     │  4  │  5  │ 6 │  +  │  -  │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼──────────┴─────┼─────┼─────┼─────┴──────┼─────┼─────┼─────┼───┼─────┼─────┤
//    │     │     │     │     │     │     │                │     │     │            │     │  1  │  2  │ 3 │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼──────────┬─────┼─────┼─────┼─────┬──────┼─────┼─────┼─────┼───┼─────┼─────┤
//    │     │     │     │     │     │     │          │     │     │     │     │      │     │     │     │ 0 │     │     │
//    └─────┴─────┴─────┴─────┴─────┘     └──────────┴─────┴─────┴─────┴─────┴──────┘     └─────┴─────┴───┴─────┴─────┘
  &trans   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp NUMBER_4   &kp NUMBER_5   &tog KP_L                                       &mo 4    &kp NUMBER_6   &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp NUMBER_0   &trans
  &trans   &trans         &trans         &trans         &trans         &trans         &trans                                          &trans   &trans         &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp MINUS      &trans
  &trans   &trans         &trans         &trans         &trans         &trans         &trans      &trans   &trans   &trans   &trans   &trans   &trans         &kp NUMBER_4   &kp NUMBER_5   &kp NUMBER_6   &kp PLUS       &kp MINUS
  &trans   &trans         &trans         &trans         &trans         &trans                              &trans   &trans                     &trans         &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &trans         &trans
  &trans   &trans         &trans         &trans         &trans                        &trans      &trans   &trans   &trans   &trans   &trans                  &trans         &trans         &kp NUMBER_0   &trans         &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┬───────┐                       ┌──────┬─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │ f1  │ f2  │ f3  │ f4  │ f5  │ tog 3 │                       │ mo 4 │ f6  │ f7  │ f8  │ f9  │ f10 │ f11 │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼───────┤                       ├──────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │       │                       │      │     │     │     │     │     │ f12 │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼───────┼─────┬─────┬─────┬─────┼──────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │       │     │     │     │     │      │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼───────┴─────┼─────┼─────┼─────┴──────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │             │     │     │            │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼───────┬─────┼─────┼─────┼─────┬──────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │       │     │     │     │     │      │     │     │     │     │     │     │
//    └─────┴─────┴─────┴─────┴─────┘     └───────┴─────┴─────┴─────┴─────┴──────┘     └─────┴─────┴─────┴─────┴─────┘
  &trans   &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &tog 3                                       &mo 4    &kp F6   &kp F7   &kp F8   &kp F9   &kp F10   &kp F11
  &trans   &trans   &trans   &trans   &trans   &trans   &none                                        &none    &trans   &trans   &trans   &trans   &trans    &kp F12
  &trans   &trans   &trans   &trans   &trans   &trans   &none    &trans   &trans   &trans   &trans   &none    &trans   &trans   &trans   &trans   &trans    &trans
  &trans   &trans   &trans   &trans   &trans   &trans                     &trans   &trans                     &trans   &trans   &trans   &trans   &trans    &trans
  &trans   &trans   &trans   &trans   &trans            &trans   &trans   &trans   &trans   &trans   &trans            &trans   &trans   &trans   &trans    &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
//    ┌────────────────┬──────────┬──────────┬──────────┬────────────┬──────────┬──────┐                              ┌─────────────┬─────┬─────────┬─────────┬─────┬─────┬────────────┐
//    │                │ bt_sel 0 │ bt_sel 1 │ bt_sel 2 │  bt_sel 3  │ bt_sel 4 │      │                              │             │     │         │         │     │     │            │
//    ├────────────────┼──────────┼──────────┼──────────┼────────────┼──────────┼──────┤                              ├─────────────┼─────┼─────────┼─────────┼─────┼─────┼────────────┤
//    │                │          │          │          │            │          │ boot │                              │    boot     │     │         │         │     │     │            │
//    ├────────────────┼──────────┼──────────┼──────────┼────────────┼──────────┼──────┼─────┬─────┬────────┬─────────┼─────────────┼─────┼─────────┼─────────┼─────┼─────┼────────────┤
//    │ &studio_unlock │          │          │          │            │          │      │     │     │ bt_clr │         │ &stp STP_B@ │     │         │         │     │     │            │
//    ├────────────────┼──────────┼──────────┼──────────┼────────────┼──────────┼──────┴─────┼─────┼────────┼─────────┴─────────────┼─────┼─────────┼─────────┼─────┼─────┼────────────┤
//    │                │          │          │          │ &macro_ver │          │            │     │        │                       │     │         │         │     │     │            │
//    ├────────────────┼──────────┼──────────┼──────────┼────────────┼──────────┼──────┬─────┼─────┼────────┼─────────┬─────────────┼─────┼─────────┼─────────┼─────┼─────┼────────────┤
//    │   &sys_reset   │          │          │          │            │          │      │     │     │        │ bl_ tog │   ug_ tog   │     │ bl_ br+ │ bl_ br- │     │     │ &sys_reset │
//    └────────────────┴──────────┴──────────┴──────────┴────────────┘          └──────┴─────┴─────┴────────┴─────────┴─────────────┘     └─────────┴─────────┴─────┴─────┴────────────┘
  &none            &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &none                                                   &trans            &none   &none        &none        &none   &none   &none
  &none            &none          &none          &none          &none          &none          &bootloader                                             &bootloader       &none   &none        &none        &none   &none   &none
  &studio_unlock   &none          &none          &none          &none          &none          &none         &none   &none   &bt BT_CLR   &none        &stp STP_BAT      &none   &none        &none        &none   &none   &none
  &none            &none          &none          &none          &macro_ver     &none                                &none   &none                                       &none   &none        &none        &none   &none   &none
  &sys_reset       &none          &none          &none          &none                         &none         &none   &none   &none        &bl BL_TOG   &rgb_ug RGB_TOG           &bl BL_INC   &bl BL_DEC   &none   &none   &sys_reset
            >;
        };

        game_layer {
            display-name = "Game";
            bindings = <
//    ┌─────┬──────┬─────┬─────┬─────┬───┬─────┐                       ┌──────┬─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │  1   │  1  │  2  │  3  │ 4 │     │                       │      │     │     │     │     │     │     │
//    ├─────┼──────┼─────┼─────┼─────┼───┼─────┤                       ├──────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │ tab │  T   │  Q  │  W  │  E  │ R │     │                       │      │     │     │     │     │     │     │
//    ├─────┼──────┼─────┼─────┼─────┼───┼─────┼─────┬─────┬─────┬─────┼──────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │ esc │ lsft │  A  │  S  │  D  │ F │  5  │     │     │     │     │      │     │     │     │     │     │     │
//    ├─────┼──────┼─────┼─────┼─────┼───┼─────┴─────┼─────┼─────┼─────┴──────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │ lctl │  Z  │  X  │  C  │ G │           │     │     │            │     │     │     │     │     │     │
//    ├─────┼──────┼─────┼─────┼─────┼───┼─────┬─────┼─────┼─────┼─────┬──────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │      │     │     │     │   │ spc │  V  │     │     │     │ bspc │     │     │     │     │     │     │
//    └─────┴──────┴─────┴─────┴─────┘   └─────┴─────┴─────┴─────┴─────┴──────┘     └─────┴─────┴─────┴─────┴─────┘
  &trans       &kp N1      &kp N1   &kp N2   &kp N3   &kp N4   &trans                                          &trans          &trans   &trans   &trans   &trans   &trans   &trans
  &kp TAB      &kp T       &kp Q    &kp W    &kp E    &kp R    &trans                                          &trans          &trans   &trans   &trans   &trans   &trans   &trans
  &kp ESCAPE   &kp LSHFT   &kp A    &kp S    &kp D    &kp F    &kp N5      &trans   &trans   &trans   &trans   &trans          &trans   &trans   &trans   &trans   &trans   &trans
  &trans       &kp LCTRL   &kp Z    &kp X    &kp C    &kp G                         &trans   &trans                            &trans   &trans   &trans   &trans   &trans   &trans
  &trans       &trans      &trans   &trans   &trans            &kp SPACE   &kp V    &trans   &trans   &trans   &kp BACKSPACE            &trans   &trans   &trans   &trans   &trans
            >;
        };
    };
};


